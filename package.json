{
  "name": "unifi-access",
  "type": "module",
  "version": "2.0.0",
  "displayName": "UniFi Access API",
  "description": "A complete UniFi Access API implementation - the native interface and the published developer API, with realtime events and typed door control.",
  "author": {
    "name": "HJD",
    "url": "https://github.com/hjdhjd"
  },
  "homepage": "https://github.com/hjdhjd/unifi-access#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git://github.com/hjdhjd/unifi-access.git"
  },
  "bugs": {
    "url": "https://github.com/hjdhjd/unifi-access/issues"
  },
  "keywords": [
    "access control",
    "door access",
    "doorbell",
    "nfc",
    "security",
    "smart lock",
    "ubiquiti",
    "uck",
    "uck g2",
    "uck g2+",
    "uck gen2",
    "uck gen2+",
    "udm",
    "udm pro",
    "udm-pro",
    "unifi",
    "unifi access",
    "unifi access api",
    "unifi cloud key",
    "unifi door access",
    "unifi dream machine pro",
    "unifios",
    "webhook"
  ],
  "engines": {
    "node": ">=22.20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "bin": {
    "ufa": "dist/util/cli/index.js"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/util/cli/index.js',0o755)\"",
    "build-docs": "node build/docs.mjs clean && npx typedoc",
    "check-docs": "node build/docs.mjs check",
    "clean": "node -e \"require('node:fs').rmSync('dist',{force:true,recursive:true})\"",
    "lint": "eslint --max-warnings=${ESLINT_MAX_WARNINGS:-\"0\"} eslint.config.mjs \"src/**/*.ts\"",
    "postpublish": "npm run clean",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm run check-docs",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/*.test.ts' --test-coverage-exclude='src/**/*.fixtures.ts' --test-coverage-exclude='src/**/*.helpers.ts' --test-coverage-lines=85 --test-coverage-branches=80 --test-coverage-functions=85 --test-timeout=15000 \"src/**/*.test.ts\"",
    "test:watch": "node --test --watch \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.6.2",
    "eslint": "9.39.2",
    "homebridge-plugin-utils": "2.4.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "undici": "8.10.2"
  }
}
